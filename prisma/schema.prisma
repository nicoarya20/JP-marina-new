generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAJER
  STAF
  PENINJAU
}

enum TaskType {
  TASK
  BUG
  QC
  TICKET
}


enum TaskStatus {
  OPEN
  IN_PROGRESS
  IN_REVIEW
  REOPENED
  DONE
}


enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}


enum ActorType {
  USER
  AI
  SYSTEM
}


enum TaskEventType {
  STATUS_CHANGED
  RESCHEDULED
  ASSIGNED
  REASSIGNED
  REVIEW_ACCEPTED
  REVIEW_RETURNED
  BLOCKED
  UNBLOCKED
  TASK_EDITED
  NUDGE_SENT
  DELETED
  RESTORED
}

model User {
  id    String   @id @default(cuid())
  name  String
  email String   @unique
  role  UserRole
  managedTeams      Team[]        @relation("TeamManager")
  teamMemberships   TeamMember[]
  ownedProjects     Project[]     @relation("ProjectOwner")
  createdTasks      Task[]        @relation("TaskCreator")
  assignedTasks     Task[]        @relation("TaskAssignee")
  reviewingTasks    Task[]        @relation("TaskReviewer")
  taskEvents        TaskEvent[]   @relation("TaskEventActor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Team {
  id   String @id @default(cuid())
  name String
  managerId String?
  manager   User?   @relation("TeamManager", fields: [managerId], references: [id])
  members  TeamMember[]
  projects Project[]
  tasks    Task[]
  createdAt DateTime @default(now())
  @@index([managerId])
}

model TeamMember {
  id     String @id @default(cuid())
  userId String
  teamId String
  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  @@unique([userId, teamId])
  @@index([teamId])
}

model Project {
  id     String        @id @default(cuid())
  name   String
  status ProjectStatus @default(ACTIVE) 
  ownerId String
  owner   User    @relation("ProjectOwner", fields: [ownerId], references: [id])
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])
  isInbox Boolean @default(false)
  tasks Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId])
  @@index([teamId])
}

model Task {
  id          String     @id @default(cuid())
  type        TaskType
  title       String
  description String?
  status      TaskStatus @default(OPEN)
  dueAt DateTime?
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])
  reviewerId String?
  reviewer   User?   @relation("TaskReviewer", fields: [reviewerId], references: [id])
  blockedAt DateTime?
  deletedAt DateTime?
  lastActivityAt   DateTime  @default(now())
  rescheduleCount  Int       @default(0)
  reopenCount      Int       @default(0)
  escalationLevel  Int       @default(0)
  lastNudgedAt     DateTime?
  events TaskEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId])
  @@index([assigneeId])
  @@index([teamId])
  @@index([status])
  @@index([deletedAt])
  @@index([rescheduleCount])
  @@index([lastActivityAt])
  @@index([dueAt])
}

model TaskEvent {
  id     String        @id @default(cuid())
  taskId String
  task   Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type TaskEventType
  actorType ActorType
  actorId String?
  actor   User?   @relation("TaskEventActor", fields: [actorId], references: [id])
  payload Json?

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}


model EscalationPolicy {
  id Int @id @default(1)
  overdueGraceHours   Int @default(24)
  stalledDays         Int @default(3)
  rescheduleThreshold Int @default(3)
  reopenThreshold     Int @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

