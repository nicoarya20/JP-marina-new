{
  "name": "task-manager-lansia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma skills sync || exit 0",
    "server:dev": "bun run --watch src/server/index.ts",
    "server:start": "bun run src/server/index.ts",
    "test": "DATABASE_URL=\"$TEST_DATABASE_URL\" bun test src/server/test",
    "db:seed": "bun run prisma/seed.ts",
    "db:seed:test": "DATABASE_URL=\"$TEST_DATABASE_URL\" bun run prisma/seed.ts"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@mantine/core": "^9.6.1",
    "@mantine/dates": "^9.6.1",
    "@mantine/form": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@prisma/client": "6",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-router": "^1.170.34",
    "@tanstack/react-start": "^1.168.51",
    "dayjs": "^1.11.23",
    "elysia": "^1.4.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
