# Penpot personal access token (get one from Penpot > Settings > Access tokens)
PENPOT_TOKEN=

# Prisma — koneksi Postgres (lihat prisma/schema.prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/task_manager_dev

# Task Manager API (Elysia, proses Bun terpisah dari Vite/TanStack Start)
# Port HTTP server API. Default 3001 kalau tidak di-set.
API_PORT=3001
# Opsional — origin yang diizinkan CORS. Kosongkan untuk izinkan semua origin (dev lokal).
CORS_ORIGIN=

# Wajib untuk `bun test` — DB Postgres TERPISAH dari dev/prod (Rule #3).
# Jalankan `bunx prisma migrate deploy` ke DB ini sebelum test pertama kali.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/task_manager_test
